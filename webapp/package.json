{
  "name": "mapsupervision-webapp",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "tsx --test tests/access-approval.test.ts tests/sync-contract.test.ts tests/google-drive-image.test.ts tests/media-route.test.ts tests/project-deletion.test.ts tests/project-catalog-migration.test.ts tests/performance-benchmark.test.ts",
    "test:performance": "tsx --test tests/performance-benchmark.test.ts",
    "test:performance:integration": "firebase emulators:exec --only firestore --project performance-benchmark-test \"tsx --test tests/performance-benchmark.test.ts\"",
    "benchmark:backend": "tsx scripts/benchmark-web-backend.ts",
    "migrate:project-catalog": "tsx scripts/migrate-project-catalog.ts",
    "test:access": "tsx --test tests/access-approval.test.ts",
    "test:media": "tsx --test tests/google-drive-image.test.ts tests/media-route.test.ts",
    "bootstrap:admins": "node scripts/bootstrap-admin-claims.cjs",
    "migrate:drive-media": "node scripts/migrate-drive-media-names.cjs",
    "release": "node ../scripts/release.mjs --target=webapp",
    "release:dry-run": "node ../scripts/release.mjs --target=webapp --dry-run"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "firebase-admin": "^13.5.0",
    "googleapis": "^173.0.0",
    "maplibre-gl": "^5.24.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "tsx": "^4.20.6",
    "typescript": "^5.7.2"
  }
}
