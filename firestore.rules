rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function accessRequestId(projectId) {
      return projectId + "__" + request.auth.uid;
    }

    function approvedAccess(projectId) {
      return isAdmin() || (
        projectIsActive(projectId) &&
        exists(/databases/$(database)/documents/accessRequests/$(accessRequestId(projectId))) &&
        get(/databases/$(database)/documents/accessRequests/$(accessRequestId(projectId))).data.status == "APPROVED"
      );
    }

    function projectIsActive(projectId) {
      return exists(/databases/$(database)/documents/projects/$(projectId)) &&
        (!("deletionState" in get(/databases/$(database)/documents/projects/$(projectId)).data) ||
          get(/databases/$(database)/documents/projects/$(projectId)).data.deletionState == "ACTIVE") &&
        (!("isDeleted" in get(/databases/$(database)/documents/projects/$(projectId)).data) ||
          get(/databases/$(database)/documents/projects/$(projectId)).data.isDeleted != true) &&
        (!("data" in get(/databases/$(database)/documents/projects/$(projectId)).data) ||
          (!("deletionState" in get(/databases/$(database)/documents/projects/$(projectId)).data.data) ||
            get(/databases/$(database)/documents/projects/$(projectId)).data.data.deletionState == "ACTIVE") &&
          (!("isDeleted" in get(/databases/$(database)/documents/projects/$(projectId)).data.data) ||
            get(/databases/$(database)/documents/projects/$(projectId)).data.data.isDeleted != true));
    }

    function allowedDataGroup(projectId, group) {
      return approvedAccess(projectId) && (
        isAdmin() ||
        get(/databases/$(database)/documents/accessRequests/$(accessRequestId(projectId))).data.allowedDataGroups.hasAny([group])
      );
    }

    function approvedMedia(projectId) {
      return approvedAccess(projectId) && (
        isAdmin() ||
        get(/databases/$(database)/documents/accessRequests/$(accessRequestId(projectId))).data.allowedDataGroups.size() > 0
      );
    }

    function isOwnUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function validUserProfileShape(uid) {
      return request.resource.data.keys().hasOnly([
        "uid",
        "email",
        "displayName",
        "emailVerified",
        "createdAtEpochMs",
        "lastLoginAtEpochMs",
        "updatedAtEpochMs",
        "isDisabled",
        "projectIds",
        "activeProjectId"
      ]) && request.resource.data.uid == uid &&
        (!("activeProjectId" in request.resource.data) ||
          request.resource.data.activeProjectId == null ||
          request.resource.data.activeProjectId is string);
    }

    function validProjectCatalogShape(data) {
      return data.keys().hasOnly([
        "projectName",
        "projectCode",
        "createdByUid",
        "updatedAtEpochMs",
        "status"
      ]) &&
        data.projectName is string &&
        data.projectName.size() > 0 &&
        data.projectCode is string &&
        data.projectCode.size() > 0 &&
        data.createdByUid is string &&
        data.createdByUid.size() > 0 &&
        data.updatedAtEpochMs is int &&
        data.updatedAtEpochMs >= 0 &&
        (data.status == "ACTIVE" || data.status == "ARCHIVED");
    }

    function validAccessRequestShape(data) {
      return data.keys().hasOnly([
        "projectId",
        "userId",
        "status",
        "allowedDataGroups",
        "contractorScope",
        "allowedContractors",
        "approvedBy",
        "approvedAtEpochMs",
        "requestedAtEpochMs",
        "updatedAtEpochMs"
      ]) &&
        data.projectId is string &&
        data.projectId.size() > 0 &&
        data.userId is string &&
        data.userId.size() > 0 &&
        data.status is string &&
        data.allowedDataGroups is list &&
        data.contractorScope is string &&
        data.allowedContractors is list &&
        data.updatedAtEpochMs is int &&
        data.updatedAtEpochMs >= 0 &&
        (data.contractorScope == "ALL" || data.contractorScope == "SCOPED") &&
        (data.status == "PENDING" || data.status == "APPROVED" ||
          data.status == "REJECTED" || data.status == "REVOKED");
    }

    function validApprovedAccessScope(data) {
      return data.allowedDataGroups.size() > 0 &&
        data.approvedBy is string &&
        data.approvedBy.size() > 0 &&
        data.approvedAtEpochMs is int &&
        data.approvedAtEpochMs >= 0 &&
        (data.contractorScope == "ALL" ||
          (data.contractorScope == "SCOPED" && data.allowedContractors.size() > 0));
    }

    function validAdminAccessTransition(previous, next) {
      return (previous == "PENDING" && (next == "APPROVED" || next == "REJECTED")) ||
        (previous == "APPROVED" && next == "REVOKED");
    }

    function validAuditShape(data) {
      return data.keys().hasOnly([
        "projectId",
        "targetUserId",
        "action",
        "previousState",
        "newState",
        "actorAdminId",
        "timestampEpochMs"
      ]) &&
        data.projectId is string &&
        data.targetUserId is string &&
        data.action is string &&
        data.previousState is string &&
        data.newState is string &&
        data.actorAdminId is string &&
        data.timestampEpochMs is int &&
        data.timestampEpochMs >= 0 &&
        validAdminAccessTransition(data.previousState, data.newState) &&
        ((data.action == "APPROVE" && data.newState == "APPROVED") ||
          (data.action == "REJECT" && data.newState == "REJECTED") ||
          (data.action == "REVOKE" && data.newState == "REVOKED"));
    }

    match /users/{uid} {
      allow read: if isOwnUser(uid) || isAdmin();
      allow create: if (
        isOwnUser(uid) &&
        validUserProfileShape(uid) &&
        request.resource.data.isDisabled == false
      ) || isAdmin();
      allow update: if (
        isOwnUser(uid) &&
        validUserProfileShape(uid) &&
        ((!("isDisabled" in resource.data) && !("isDisabled" in request.resource.data)) ||
          request.resource.data.isDisabled == resource.data.isDisabled) &&
        ((!("projectIds" in resource.data) && !("projectIds" in request.resource.data)) ||
          request.resource.data.projectIds == resource.data.projectIds)
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    match /projectCatalog/{projectId} {
      // projectCatalog is a dedicated, sanitized projection. Its exact shape
      // is enforced for all client/admin writes below; project detail fields
      // are never read from /projects by catalog clients.
      allow read: if isSignedIn();
      allow create: if isAdmin() && validProjectCatalogShape(request.resource.data);
      allow update: if isAdmin() &&
        validProjectCatalogShape(request.resource.data) &&
        request.resource.data.createdByUid == resource.data.createdByUid;
      allow delete: if isAdmin();
    }

    match /catalogMigrations/{runId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /accessRequests/{requestId} {
      // A catalog client probes its own request document before creating one.
      // Missing documents contain no data to expose and must not be denied.
      allow read: if isAdmin() || (isSignedIn() &&
        (!exists(/databases/$(database)/documents/accessRequests/$(requestId)) ||
          resource.data.userId == request.auth.uid));
      allow create: if isSignedIn() && !isAdmin() &&
        validAccessRequestShape(request.resource.data) &&
        requestId == request.resource.data.projectId + "__" + request.resource.data.userId &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == "PENDING" &&
        request.resource.data.contractorScope == "ALL" &&
        request.resource.data.allowedDataGroups.size() == 0 &&
        request.resource.data.allowedContractors.size() == 0 &&
        request.resource.data.approvedBy == null &&
        request.resource.data.approvedAtEpochMs == null &&
        exists(/databases/$(database)/documents/projectCatalog/$(request.resource.data.projectId));
      allow update: if (
        isSignedIn() && !isAdmin() &&
        validAccessRequestShape(request.resource.data) &&
        requestId == request.resource.data.projectId + "__" + request.resource.data.userId &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.projectId == resource.data.projectId &&
        (resource.data.status == "REJECTED" || resource.data.status == "REVOKED") &&
        request.resource.data.status == "PENDING" &&
        request.resource.data.contractorScope == "ALL" &&
        request.resource.data.allowedDataGroups.size() == 0 &&
        request.resource.data.allowedContractors.size() == 0 &&
        request.resource.data.approvedBy == null &&
        request.resource.data.approvedAtEpochMs == null &&
        exists(/databases/$(database)/documents/projectCatalog/$(request.resource.data.projectId))
      ) || (
        isAdmin() &&
        validAccessRequestShape(request.resource.data) &&
        requestId == request.resource.data.projectId + "__" + request.resource.data.userId &&
        request.resource.data.projectId == resource.data.projectId &&
        request.resource.data.userId == resource.data.userId &&
        validAdminAccessTransition(resource.data.status, request.resource.data.status) &&
        (request.resource.data.status != "APPROVED" || validApprovedAccessScope(request.resource.data)) &&
        exists(/databases/$(database)/documents/projectCatalog/$(request.resource.data.projectId))
      );
      allow delete: if false;

      match /accessAudit/{auditId} {
        allow read: if isAdmin();
        allow create: if isAdmin() &&
          validAuditShape(request.resource.data) &&
          request.resource.data.actorAdminId == request.auth.uid &&
          get(/databases/$(database)/documents/accessRequests/$(requestId)).data.status == request.resource.data.previousState &&
          getAfter(/databases/$(database)/documents/accessRequests/$(requestId)).data.status == request.resource.data.newState;
        allow update, delete: if false;
      }
    }

    match /projects/{projectId} {
      allow read: if isAdmin() || approvedAccess(projectId);
      allow create: if isAdmin();
      allow update: if isAdmin() && projectIsActive(projectId) &&
        (!("deletionState" in request.resource.data) ||
          request.resource.data.deletionState == "ACTIVE");
      allow delete: if false;

      match /projectMembers/{memberId} {
        allow read: if approvedAccess(projectId);
        allow write: if isAdmin() && projectIsActive(projectId);
      }

      match /{collectionName}/{documentId} {
        allow read: if projectIsActive(projectId) && ((collectionName == "site_photos" && approvedMedia(projectId)) ||
          (collectionName != "site_photos" && allowedDataGroup(projectId, collectionName)));
        allow write: if projectIsActive(projectId) && allowedDataGroup(projectId, collectionName);
      }
    }

    match /projectDeletionTombstones/{projectId} {
      allow read: if isAdmin() ||
        (isSignedIn() &&
          (!exists(/databases/$(database)/documents/projectDeletionTombstones/$(projectId)) ||
            (resource.data.memberUids is list && resource.data.memberUids.hasAny([request.auth.uid]))));
      allow write: if false;
    }

    match /projectDeletionAudit/{auditId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
