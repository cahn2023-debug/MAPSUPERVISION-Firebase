{
    "mcpServers": {
        "knowns": {
            "command": "knowns",
            "args": [
                "mcp",
                "--stdio"
            ]
        },
        "context7": {
            "command": "npx",
            "args": [
                "-y",
                "@upstash/context7-mcp",
                "--api-key",
                "YOUR_API_KEY"
            ]
        }
    }
}